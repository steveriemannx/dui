<?xml version="1.0" encoding="UTF-8"?>
<!-- Message box layout: a fixed width of 420; the root container uses height="auto", so the window height follows the message text -->
<Window size="420,200" caption="0,0,0,36" use_system_caption="false"
        sys_menu="true" sys_menu_rect="0,0,36,36"
        shadow_type="default" shadow_attached="true"
        layered_window="true" size_box="0,0,0,0"
        icon="public/caption/logo.ico">
    <VBox width="420" height="auto" bkcolor="bg_window_main" max_height="600">
        <!-- Caption bar: only the close button is kept; there is no minimize/maximize -->
        <HBox name="window_title_bar" width="stretch" height="36" bkcolor="bg_titlebar">
            <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="8" tab_stop="false"/>
            <Label name="msg_title" valign="center" margin="8,0,0,0" mouse_enabled="false" tab_stop="false"/>
            <Control tab_stop="false"/>
            <Button class="btn_wnd_close_11" height="stretch" width="40" name="btn_window_close"/>
        </HBox>

        <!-- Message area: an icon plus multi-line text (the text wraps automatically and the height follows) -->
        <HBox width="stretch" height="auto" padding="20,20,20,4">
            <Control name="msg_icon" width="32" height="32" valign="top" margin="0,0,14,0" tab_stop="false"/>
            <Label name="msg_text" width="stretch" height="auto" min_height="32"
                   multi_line="true" font="system_14" tab_stop="false"
                   normal_text_color="text_default" text_align="hleft,vcenter"/>
        </HBox>

        <!-- Button area: right aligned; every button is hidden by default and MessageBoxWnd shows the requested set -->
        <!-- The focus rectangle is shown on demand: it starts hidden and MessageBoxWnd::OnKeyDownMsg enables it when the user navigates with TAB -->
        <HBox width="stretch" height="auto" child_halign="right" padding="20,12,20,20" child_margin_x="10">
            <Button class="btn_global_white_80x30" name="btn_retry" text="Retry" width="80" height="32" visible="false"/>
            <Button class="btn_global_white_80x30" name="btn_yes" text="Yes" width="80" height="32" visible="false"/>
            <Button class="btn_global_white_80x30" name="btn_no" text="No" width="80" height="32" visible="false"/>
            <Button class="btn_global_white_80x30" name="btn_ok" text="OK" width="80" height="32" visible="false"/>
            <Button class="btn_global_white_80x30" name="btn_cancel" text="Cancel" width="80" height="32" visible="false"/>
        </HBox>
    </VBox>
</Window>
