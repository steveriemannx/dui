<?xml version="1.0" encoding="UTF-8"?>
<Window text="Binding" show_caption_title="true" size="560,470" min_size="460,380"
        caption="0,0,0,36" use_system_caption="false" snap_layout_menu="true" sys_menu="true" sys_menu_rect="0,0,36,36"
        shadow_type="draw_none" shadow_snap="true"
        alpha="255" layered_window="true" size_box="4,4,4,4" size_contain_shadow="true" shadow_border_size="0" icon="public/caption/logo.ico">
    <VBox bkcolor="bk_wnd_darkcolor" visible="true" border_size="3" border_color="bk_caption_color" border_round="0,0">
        <!-- Title bar area -->
        <HBox name="window_caption_bar" width="stretch" height="36" bkcolor="bk_caption_color">
            <!-- Title bar: display area at the top-left of the window -->
            <HBox margin="0,0,30,0" valign="center" width="auto" height="auto" mouse_enabled="false">
                <Label name="window_caption_title" valign="center" margin="8,0,0,0" mouse_enabled="false"/>
            </HBox>
            <Control width="stretch" mouse_enabled="false"/>
            <HBox width="auto" height="stretch" float="true" halign="right" valign="top">
                <Button class="btn_wnd_min_11" height="32" width="26" name="minbtn" margin="0,2,0,2" tooltip_text="Minimize"/>
                <Box height="stretch" width="26" margin="0,2,0,2">
                    <Button class="btn_wnd_max_11" height="32" width="stretch" name="maxbtn" tooltip_text="Maximize"/>
                    <Button class="btn_wnd_restore_11" height="32" width="stretch" name="restorebtn" visible="false" tooltip_text="Restore"/>
                </Box>
                <Button class="btn_wnd_close_11" height="32" width="26" name="closebtn" margin="0,2,6,2" tooltip_text="Close"/>
            </HBox>
        </HBox>

        <!-- Work area: everything outside the title bar goes into this large Box area -->
        <Box>
            <VBox halign="center" width="stretch" margin="24,18,24,18">
                <Label text="Nothing below is refreshed by hand." font="system_14" height="24" width="stretch"
                       text_align="hcenter" mouse_enabled="false" margin="0,0,0,16"/>

                <!-- These two labels follow the SAME view-model property. Add a third
                     display point and it is one more Bind() line, not another refresh call. -->
                <Label name="count_label" text="Count: 0" font="system_14" height="30" width="stretch"
                       text_align="hcenter" mouse_enabled="false" margin="0,0,0,4"/>
                <Label name="mirror_label" text="Count: 0 (mirror)" height="22" width="stretch"
                       text_align="hcenter" mouse_enabled="false" margin="0,0,0,16"/>

                <!-- One-way: Progress fires no value-changed event, so it cannot be two-way. -->
                <Progress name="count_progress" class="progress_horizontal_blue" value="0" height="14" width="86%"
                          halign="center" mouse_enabled="false" margin="0,0,0,18"/>

                <!-- Visibility follows the view model; the toggle button decides the value. -->
                <Label name="detail_label" text="This label's visible follows the view model." height="22" width="stretch"
                       text_align="hcenter" mouse_enabled="false" margin="0,0,0,18"/>

                <HBox halign="center" height="34">
                    <Button name="btn_inc" class="btn_global_blue_80x30" text="+1" width="90" height="32" margin="4,0,4,0"/>
                    <Button name="btn_dec" class="btn_global_blue_80x30" text="-1" width="90" height="32" margin="4,0,4,0"/>
                    <Button name="btn_toggle" class="btn_global_blue_80x30" text="Toggle detail" width="120" height="32" margin="4,0,4,0"/>
                </HBox>

                <Control height="22" mouse_enabled="false"/>
                <Control height="1" width="86%" halign="center" bkcolor="bk_wnd_lightcolor" mouse_enabled="false"/>
                <Control height="22" mouse_enabled="false"/>

                <!-- The style that predates the binding module: a stored control pointer
                     and a hand-written refresh. It still works, unchanged, right next to
                     the bound controls above. -->
                <HBox halign="center" height="34">
                    <Button name="btn_legacy" class="btn_global_blue_80x30" text="Legacy +1" width="120" height="32" margin="4,0,4,0"/>
                    <Label name="legacy_label" text="Count: 0" width="160" height="32" valign="center"
                           mouse_enabled="false" margin="10,0,4,0"/>
                </HBox>
            </VBox>
        </Box>
    </VBox>
</Window>
