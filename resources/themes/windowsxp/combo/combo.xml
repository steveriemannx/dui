<?xml version="1.0" encoding="UTF-8"?>
<Window size="700,320" min_size="400,300"
        caption="0,0,0,36" use_system_caption="false"
        shadow_type="draw_none"
        alpha="255" layered_window="true" icon="public/caption/logo.ico">
    <VBox bkcolor="bk_wnd_darkcolor">
        <!-- Title bar area -->
        <HBox name="window_caption_bar" width="stretch" height="36" bkcolor="bk_caption_color">
            <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="8"/>
            <Label name="window_caption_title" text="Combo - Square Corners" valign="center" margin="8" mouse_enabled="false"/>
            <Control mouse_enabled="false"/>
            <Button class="btn_wnd_min_11" height="32" width="26" name="minbtn" margin="0,2,0,2" tooltip_text="Minimize"/>
            <Button class="btn_wnd_close_11" height="stretch" width="26" name="closebtn" margin="0,0,8,2" tooltip_text="Close"/>
        </HBox>

        <!-- Work area -->
        <VBox padding="24,20,24,20">
            <!-- Row 1: drop_list combos -->
            <Label text="drop_list (read-only)" height="24" font="system_bold_14" margin="0,0,0,8"/>
            <HBox height="40" margin="0,0,0,16">
                <VBox width="160" margin="0,0,8,0">
                    <Label text="system_not_round" height="18" font="system_12" text_align="hcenter" margin="0,0,0,4"/>
                    <Combo class="combo" name="combo_default" combo_type="drop_list"
                           shadow_type="system_not_round" dropbox_size="160,150" height="28"/>
                </VBox>
                <VBox width="160" margin="0,0,8,0">
                    <Label text="system_default" height="18" font="system_12" text_align="hcenter" margin="0,0,0,4"/>
                    <Combo class="combo" name="combo_small_round" combo_type="drop_list"
                           shadow_type="system_default" dropbox_size="160,150" height="28"/>
                </VBox>
                <VBox width="160" margin="0,0,8,0">
                    <Label text="system_small_round" height="18" font="system_12" text_align="hcenter" margin="0,0,0,4"/>
                    <Combo class="combo" name="combo_round" combo_type="drop_list"
                           shadow_type="system_small_round" dropbox_size="160,150" height="28"/>
                </VBox>
                <VBox width="160">
                    <Label text="system_round" height="18" font="system_12" text_align="hcenter" margin="0,0,0,4"/>
                    <Combo class="combo" name="combo_not_round" combo_type="drop_list"
                           shadow_type="system_round" dropbox_size="160,150" height="28"/>
                </VBox>
            </HBox>

            <!-- Row 2: drop_down (editable) combos -->
            <Label text="drop_down (editable)" height="24" font="system_bold_14" margin="0,0,0,8"/>
            <HBox height="40" margin="0,0,0,16">
                <VBox width="160" margin="0,0,8,0">
                    <Label text="system_not_round" height="18" font="system_12" text_align="hcenter" margin="0,0,0,4"/>
                    <Combo class="combo" name="combo_edit_default" combo_type="drop_down"
                           shadow_type="system_not_round" dropbox_size="160,150" height="28"/>
                </VBox>
                <VBox width="160" margin="0,0,8,0">
                    <Label text="system_default" height="18" font="system_12" text_align="hcenter" margin="0,0,0,4"/>
                    <Combo class="combo" name="combo_edit_small_round" combo_type="drop_down"
                           shadow_type="system_default" dropbox_size="160,150" height="28"/>
                </VBox>
                <VBox width="160" margin="0,0,8,0">
                    <Label text="system_small_round" height="18" font="system_12" text_align="hcenter" margin="0,0,0,4"/>
                    <Combo class="combo" name="combo_edit_round" combo_type="drop_down"
                           shadow_type="system_small_round" dropbox_size="160,150" height="28"/>
                </VBox>
                <VBox width="160">
                    <Label text="system_round" height="18" font="system_12" text_align="hcenter" margin="0,0,0,4"/>
                    <Combo class="combo" name="combo_edit_not_round" combo_type="drop_down"
                           shadow_type="system_round" dropbox_size="160,150" height="28"/>
                </VBox>
            </HBox>

            <!-- Row 3: FilterCombo -->
            <Label text="FilterCombo" height="24" font="system_bold_14" margin="0,0,0,8"/>
            <HBox height="40">
                <VBox width="160" margin="0,0,8,0">
                    <Label text="system_not_round" height="18" font="system_12" text_align="hcenter" margin="0,0,0,4"/>
                    <FilterCombo class="filter_combo" name="filter_default"
                                 shadow_type="system_not_round" dropbox_size="160,150" height="28"/>
                </VBox>
                <VBox width="160" margin="0,0,8,0">
                    <Label text="system_default" height="18" font="system_12" text_align="hcenter" margin="0,0,0,4"/>
                    <FilterCombo class="filter_combo" name="filter_small_round"
                                 shadow_type="system_default" dropbox_size="160,150" height="28"/>
                </VBox>
                <VBox width="160" margin="0,0,8,0">
                    <Label text="system_small_round" height="18" font="system_12" text_align="hcenter" margin="0,0,0,4"/>
                    <FilterCombo class="filter_combo" name="filter_round"
                                 shadow_type="system_small_round" dropbox_size="160,150" height="28"/>
                </VBox>
                <VBox width="160">
                    <Label text="system_round" height="18" font="system_12" text_align="hcenter" margin="0,0,0,4"/>
                    <FilterCombo class="filter_combo" name="filter_not_round"
                                 shadow_type="system_round" dropbox_size="160,150" height="28"/>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</Window>
