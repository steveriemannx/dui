<?xml version="1.0" encoding="UTF-8"?>
<Window size="540,535" caption="0,0,0,36" use_system_caption="false" shadow_attached="true" layered_window="true">
    <!-- Chat area -->
    <VBox>
        <!-- Title bar area -->
        <HBox name="window_caption_bar" width="stretch" height="36" bkcolor="bk_wnd_lightcolor">
            <Label text="App List" font="system_bold_14" margin="10,10" mouse_enabled="false"/>
            <Control mouse_enabled="false"/>
            <Button class="btn_wnd_min_11" height="32" width="40" name="minbtn" margin="0,2,0,2" tooltip_text="Minimize"/>
            <Box height="stretch" width="40" margin="0,2,0,2">
                <Button class="btn_wnd_max_11" height="32" width="stretch" name="maxbtn" tooltip_text="Maximize"/>
                <Button class="btn_wnd_restore_11" height="32" width="stretch" name="restorebtn" visible="false" tooltip_text="Restore"/>
            </Box>
            <Button class="btn_wnd_close_11" height="stretch" width="40" name="closebtn" margin="0,0,0,2" tooltip_text="Close"/>
        </HBox>
        <Control class="splitline_hor_level1"/>
        <VBox height="200" bkcolor="bk_wnd_lightcolor">
	        <HBox bkcolor="bk_wnd_darkcolor" height="35" >
                <Label text="Common Apps" font="system_14" margin="10,10"/>
            </HBox>
            <VTileBox name="frequent_app" child_halign="left" drop_in_id="1" drag_out_id="1" bkcolor="white"/>
        </VBox>
        <Control class="splitline_hor_level1"/>
        <VBox bkcolor="bk_wnd_lightcolor">
            <HBox bkcolor="bk_wnd_darkcolor" height="35" >
                <Label text="My Apps" font="system_14" margin="10,10"/>
            </HBox>
            <VTileBox name="my_app" child_halign="left" drop_in_id="1" drag_out_id="1" bkcolor="white"/>
        </VBox>
    </VBox>
</Window>