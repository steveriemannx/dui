<?xml version="1.0" encoding="UTF-8"?>
<!-- Structure template for a child window; the root node name is arbitrary, as long as it conforms to the XML specification -->
<ChildWindowTemplate>
    <ChildWindow valign="center" halign="center" child_window_margin="12,36,12,12">
        <HBox padding="12,0,0,0" valign="top" height="36">
            <Label name="child_window_name" text="ChildWindow1" margin="2,0,2,0" valign="center" mouse_enabled="false"/>
            <Label text="Frame Rate FPS:" valign="center" mouse_enabled="false"/>
            <Label name="label_fps" text="0000" width="42" margin="4,0,4,0" valign="center" mouse_enabled="false"/>
            <CheckBox class="checkbox_1" name="fps_paint" height="28" width="auto" text="Draw" valign="center" selected="true"/>
            <CheckBox class="checkbox_1" name="child_fullscreen" height="28" width="auto" text="Fullscreen" valign="center" margin="8,0,0,0" selected="false"/>
        </HBox>
    </ChildWindow>
</ChildWindowTemplate>