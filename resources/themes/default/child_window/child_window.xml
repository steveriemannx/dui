<?xml version="1.0" encoding="UTF-8"?>
<Window size="75%,85%" min_size="240,100"
        caption="0,0,0,36" use_system_caption="false" snap_layout_menu="false" sys_menu="true" sys_menu_rect="0,0,36,36" 
        shadow_type="none" shadow_attached="true" shadow_snap="true" layered_window="false"
        size_box="4,4,4,4" icon="public/caption/logo.ico">
    <VBox bkcolor="bk_wnd_darkcolor" visible="true">    
        <!-- Title bar area -->  
        <HBox name="window_caption_bar" width="stretch" height="36" bkcolor="bk_wnd_lightcolor">
            <!-- Title bar: display area at the top-left of the window -->  
            <HBox margin="0,0,30,0" valign="center" width="auto" height="auto" mouse_enabled="false">
                <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="8,0,0,0"/>
                <Label text="ChildWindow Control Test Program" valign="center" margin="8,0,0,0" mouse_enabled="false"/>
            </HBox>
            <Control mouse_enabled="false"/>            
            <!-- Title bar: window control area on the right; minimize, maximize, restore, and close buttons -->
            <HBox margin="0,0,0,0" valign="center" width="auto" height="36">
                <Button class="btn_wnd_min_11" height="32" width="40" name="minbtn" margin="0,2,0,2" tooltip_text="Minimize"/>
                <Box height="stretch" width="40" margin="0,2,0,2">
                    <Button class="btn_wnd_max_11" height="32" width="stretch" name="maxbtn" tooltip_text="Maximize"/>
                    <Button class="btn_wnd_restore_11" height="32" width="stretch" name="restorebtn" visible="false" tooltip_text="Restore"/>
                </Box>
                <Button class="btn_wnd_close_11" height="stretch" width="40" name="closebtn" margin="0,0,0,2" tooltip_text="Close"/>
            </HBox>
        </HBox> <!-- End of title bar area --> 
        
        <!-- Work area: everything outside the title bar goes into this large Box area -->
        <Box>
            <GridBox name="child_window_box" valign="center" rows="3" columns="3" bkcolor="#FFF0F0F0" > 
                <Include src="child_window_item.xml" count="9"/>
            </GridBox>
        </Box>
    </VBox>
</Window>