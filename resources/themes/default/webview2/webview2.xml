<?xml version="1.0" encoding="UTF-8"?>
<Window size="700,500" caption="0,0,0,36" shadow_type="default" shadow_attached="true" layered_window="true" size_box="4,4,4,4">
    <VBox bkcolor="bk_wnd_darkcolor">
        <!-- Title bar area -->
        <HBox name="window_caption_bar" width="stretch" height="36" bkcolor="bk_wnd_lightcolor">
            <Label name="page_title" width="stretch" height="32" text_align="left,vcenter" text_padding="8,2,5,0" mouse_enabled="false"/>
            <Button name="btn_dev_tool" height="32" width="40" margin="0,2,4,2" valign="center" 
                          tooltip_text="Developer Tools" bkimage="file='dev_tool.svg' height='20' width='20' halign='center' valign='center'"
                          hot_color="AliceBlue" pushed_color="Lavender"/>
            <Button class="btn_view_fullscreen_11" height="32" width="40" name="webview2_full_screen_btn" margin="0,2,0,2" tooltip_text="Page fullscreen, press ESC to exit"/>
            <Button class="btn_wnd_fullscreen_11" height="32" width="40" name="fullscreenbtn" margin="0,2,0,2" tooltip_text="Window fullscreen, press ESC to exit"/>
            <Button class="btn_wnd_min_11" height="32" width="40" name="minbtn" margin="0,2,0,2" tooltip_text="Minimize"/>
            <Box height="stretch" width="40" margin="0,2,0,2">
                <Button class="btn_wnd_max_11" height="32" width="stretch" name="maxbtn" tooltip_text="Maximize"/>
                <Button class="btn_wnd_restore_11" height="32" width="stretch" name="restorebtn" visible="false" tooltip_text="Restore"/>
            </Box>
            <Button class="btn_wnd_close_11" height="stretch" width="40" name="closebtn" margin="0,0,0,2" tooltip_text="Close"/>
        </HBox>
        
        <!-- Work area: everything outside the title bar goes into this large Box area -->   
        <HBox height="auto">
            <Button class="btn_global_blue_80x30" name="btn_back" text="Back" width="60"/>
            <Button class="btn_global_blue_80x30" name="btn_forward" text="Forward" width="60" margin="5,0,5"/>
            <RichEdit class="simple simple_border prompt" name="edit_url" 
                                                  width="stretch" height="28" valign="center" text_padding="5,0,5,0" 
                                                  prompt_text="Enter URL"
                                                  default_context_menu="true"/>
            <Button class="btn_global_blue_80x30" name="btn_navigate" text="Go to" width="60" margin="5"/>
            <Button class="btn_global_blue_80x30" name="btn_refresh" text="Refresh" width="60" margin="5"/>
        </HBox>
        <VBox bkcolor="white">
            <WebView2Control name="webview2_control" url="https://www.baidu.com" F12="true" margin="2,0,2,2"/>
        </VBox>
    </VBox>
</Window>