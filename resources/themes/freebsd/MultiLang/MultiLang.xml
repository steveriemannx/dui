<?xml version="1.0" encoding="UTF-8"?>
<Window text_id="MULTI_LANG_WINDOW_TEXT" size="600,400" min_size="80,50" use_system_caption="false" caption="0,0,0,32" shadow_type="draw_default" shadow_attached="true" size_box="4,4,4,4">
    <Class name="btn_language" normal_image="file='language.svg' width='18' height='18' valign='center' halign='center'" hot_color="#FFE5E5E5" pushed_color="#FFC8C8C8"/>
    <VBox bkcolor="bk_wnd_darkcolor" visible="true">    
        <!-- Title bar area -->
        <HBox name="window_caption_bar" width="stretch" height="32" bkcolor="bk_wnd_lightcolor">
            <Label text_id="MULTI_LANG_WINDOW_TEXT" height="32" width="stretch" margin="8,0,0,0" text_align="vcenter,left" mouse_enabled="false"/>
            <Control width="40" mouse_enabled="false"/>
            <Button class="btn_language" height="32" width="40" name="language" margin="0,0,0,0" tooltip_textid="MULTI_LANG_SELECT_LANGUAGE"/>
            <Button class="btn_wnd_min_11" height="32" width="46" name="minbtn" margin="0,0,0,0" tooltip_textid="MULTI_LANG_SELECT_WINDOW_MIN"/>
            <Box height="stretch" width="46" margin="0,0,0,0">
                <Button class="btn_wnd_max_11" height="32" width="stretch" name="maxbtn" tooltip_textid="MULTI_LANG_SELECT_WINDOW_MAX"/>
                <Button class="btn_wnd_restore_11" height="32" width="stretch" name="restorebtn" visible="false" tooltip_textid="MULTI_LANG_SELECT_WINDOW_RESTORE"/>
            </Box>
            <Button class="btn_wnd_close_11" height="stretch" width="46" name="closebtn" margin="0,0,0,0" tooltip_textid="MULTI_LANG_SELECT_WINDOW_CLOSE"/>
        </HBox>
        
        <!-- Work area: everything outside the title bar goes into this large Box area -->
        <Box>
            <VBox margin="0,0,0,0" valign="center" halign="center">
                <Label text_id="LANGUAGE_DISPLAY_NAME" height="20%" width="100%" text_align="hcenter,vcenter" bkcolor="AntiqueWhite"/>
                <Label text_id="MULTI_LANG_LABEL_TEXT" height="20%" width="100%" text_align="hcenter,vcenter" bkcolor="LightCyan"/>
                <RichText trim_policy="none" text_id="MULTI_LANG_RICH_TEXT" height="20%" width="100%" text_align="hcenter,vcenter" bkcolor="NavajoWhite"/>
                <Label rich_text="true" text_id="MULTI_LANG_RICH_TEXT" height="auto" width="auto" text_align="hcenter,vcenter" text_padding="10,10,10,10" bkcolor="LightCyan"/>
            </VBox>
        </Box>
    </VBox>
</Window>
