# commit; see README.md in this directory. Applied with -p1 -N -f from the root of
# the extracted tree.
#
# Files: 1
#   src/base/SkDebug.cpp
--- a/src/base/SkDebug.cpp
+++ b/src/base/SkDebug.cpp
@@ -12,13 +12,30 @@
 #include "include/private/base/SkAttributes.h" // IWYU pragma: keep
 #include "include/private/base/SkLog.h"
 
+#if defined(__FreeBSD__)
+    #include <cstdarg>
+    #include <cstdio>
+    // Unified implementation for SkDebugf (variadic) and VSkDebugf (va_list)
+    static void VSkDebugf(const char* format, va_list args) {
+        vfprintf(stderr, format, args);
+        fflush(stderr);
+    }
+    // The main debug output function
+    void SkDebugf(const char format[], ...) {
+        va_list args;
+        va_start(args, format);
+        VSkDebugf(format, args);  // Reuse VSkDebugf
+        va_end(args);
+    }
+#endif
+
 #if defined(SK_BUILD_FOR_GOOGLE3)
 void SkDebugfForDumpStackTrace(const char* data, void* unused) {
     SkDebugf("%s", data);
 }
 #endif
 
