-SI void from_4444(U16 rgba, U16* r, U16* g, U16* b, U16* a) {
-    // Format for 4444 buffers: 15|rrrr gggg bbbb aaaa|0.
-    U16 R = (rgba >> 12) & 15,
-        G = (rgba >>  8) & 15,
-        B = (rgba >>  4) & 15,
-        A = (rgba >>  0) & 15;
-
-    // Scale [0,15] to [0,255].
-    *r = (R << 4) | R;
-    *g = (G << 4) | G;
-    *b = (B << 4) | B;
-    *a = (A << 4) | A;
-}
-SI void load_4444_(const uint16_t* ptr, U16* r, U16* g, U16* b, U16* a) {
