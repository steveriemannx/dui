-#elif defined(SKRP_CPU_NEON)
-    template <typename T> using V = Vec<4, T>;
-    using F   = V<float   >;
-    using I32 = V< int32_t>;
-    using U64 = V<uint64_t>;
-    using U32 = V<uint32_t>;
-    using U16 = V<uint16_t>;
-    using U8  = V<uint8_t >;
