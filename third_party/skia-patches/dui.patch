-SI void store_4444_(uint16_t* ptr, U16 r, U16 g, U16 b, U16 a) {
-    r = min(r, 255);
-    g = min(g, 255);
-    b = min(b, 255);
-    a = min(a, 255);
-
-    // Round from [0,255] to [0,15], producing the same value as (x*(15/255.0f) + 0.5f).
-    U16 R = (r + 8) / 17,
-        G = (g + 8) / 17,
-        B = (b + 8) / 17,
-        A = (a + 8) / 17;
-    // Pack them back into 15|rrrr gggg bbbb aaaa|0.
-    store(ptr, R << 12
-             | G <<  8
-             | B <<  4
-             | A <<  0);
-}
