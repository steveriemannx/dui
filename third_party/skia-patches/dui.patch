-namespace {
-struct Context {
-    SkTScopedComPtr<IDWriteFontFace4> fontFace4;
-    void* glyphDataContext;
-    Context(IDWriteFontFace4* face4, void* context)
-        : fontFace4(SkRefComPtr(face4))
-        , glyphDataContext(context)
-    {}
-};
