-#define STAGE_PARAMS(MAYBE_REF) SKCMS_MAYBE_UNUSED const char* src, \
-                                SKCMS_MAYBE_UNUSED char* dst,       \
-                                SKCMS_MAYBE_UNUSED F MAYBE_REF r,   \
-                                SKCMS_MAYBE_UNUSED F MAYBE_REF g,   \
