-// load 4 floats from memory, and splat them into dr,dg,db,da
-HIGHP_STAGE(uniform_color_dst, const SkRasterPipelineContexts::UniformColorCtx* c) {
-    dr = F_(c->r);
-    dg = F_(c->g);
-    db = F_(c->b);
-    da = F_(c->a);
