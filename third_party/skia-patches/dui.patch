+HIGHP_STAGE(clamp_gamut, NoCtx) {
+    a = min(max(a, 0.0f), 1.0f);
+    r = min(max(r, 0.0f), a);
+    g = min(max(g, 0.0f), a);
+    b = min(max(b, 0.0f), a);
+}
+
+HIGHP_STAGE(set_rgb, const float* rgb) {
+    r = F_(rgb[0]);
+    g = F_(rgb[1]);
+    b = F_(rgb[2]);
+}
