-    U16 c = load_8(ptr_at_xy<const uint8_t>(ctx, dx,dy));
-    r = div255( r * c );
-    g = div255( g * c );
-    b = div255( b * c );
-    a = div255( a * c );
-}
-LOWP_STAGE_PP(lerp_u8, const SkRasterPipelineContexts::MemoryCtx* ctx) {
-    U16 c = load_8(ptr_at_xy<const uint8_t>(ctx, dx,dy));
-    r = lerp(dr, r, c);
-    g = lerp(dg, g, c);
-    b = lerp(db, b, c);
-    a = lerp(da, a, c);
-}
