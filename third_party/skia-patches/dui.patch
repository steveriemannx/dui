-LOWP_STAGE_PP(move_src_dst, NoCtx) {
-    dr = r;
-    dg = g;
-    db = b;
-    da = a;
-}
-
-LOWP_STAGE_PP(move_dst_src, NoCtx) {
-    r = dr;
