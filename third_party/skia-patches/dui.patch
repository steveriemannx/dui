-SI RGB css_hsl_to_srgb_(F h, F s, F l) {
-    h = mod_(h, 360);
-
-    s *= 0.01f;
-    l *= 0.01f;
-
-    F k[3] = {
-        mod_(0 + h * (1 / 30.0f), 12),
-        mod_(8 + h * (1 / 30.0f), 12),
-        mod_(4 + h * (1 / 30.0f), 12)
-    };
-    F a  = s * min(l, 1 - l);
-    return {
-        l - a * max(-1.0f, min(min(k[0] - 3.0f, 9.0f - k[0]), 1.0f)),
-        l - a * max(-1.0f, min(min(k[1] - 3.0f, 9.0f - k[1]), 1.0f)),
-        l - a * max(-1.0f, min(min(k[2] - 3.0f, 9.0f - k[2]), 1.0f))
-    };
-}
