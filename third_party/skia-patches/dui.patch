-    F gray = g / (g + b);
-
-    RGB rgb = css_hsl_to_srgb_(r, F_(100.0f), F_(50.0f));
-    rgb.r = rgb.r * (1 - g - b) + g;
-    rgb.g = rgb.g * (1 - g - b) + g;
-    rgb.b = rgb.b * (1 - g - b) + g;
-
