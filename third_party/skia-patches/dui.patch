+HIGHP_STAGE(unbounded_set_rgb, const float* rgb) {
+    r = F_(rgb[0]);
+    g = F_(rgb[1]);
+    b = F_(rgb[2]);
+}
+
+HIGHP_STAGE(swap_rb, NoCtx) {
+    auto tmp = r;
+    r = b;
+    b = tmp;
+}
+HIGHP_STAGE(swap_rb_dst, NoCtx) {
+    auto tmp = dr;
+    dr = db;
+    db = tmp;
+}
+
+HIGHP_STAGE(move_src_dst, NoCtx) {
+    dr = r;
+    dg = g;
+    db = b;
+    da = a;
+}
+HIGHP_STAGE(move_dst_src, NoCtx) {
+    r = dr;
+    g = dg;
+    b = db;
+    a = da;
+}
+HIGHP_STAGE(swap_src_dst, NoCtx) {
+    std::swap(r, dr);
+    std::swap(g, dg);
+    std::swap(b, db);
+    std::swap(a, da);
+}
