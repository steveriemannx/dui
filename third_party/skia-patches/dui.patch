+HIGHP_STAGE(premul, NoCtx) {
+    r = r * a;
+    g = g * a;
+    b = b * a;
+}
+HIGHP_STAGE(premul_dst, NoCtx) {
+    dr = dr * da;
+    dg = dg * da;
+    db = db * da;
