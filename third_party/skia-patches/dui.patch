-    }
-
-    SI void load4(const float* ptr, F* r, F* g, F* b, F* a) {
-        *r = ptr[0];
-        *g = ptr[1];
-        *b = ptr[2];
-        *a = ptr[3];
-    }
-    SI void store4(float* ptr, F r, F g, F b, F a) {
-        ptr[0] = r;
