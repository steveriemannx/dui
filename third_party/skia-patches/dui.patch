+HIGHP_STAGE(unpremul, NoCtx) {
+    float inf = sk_bit_cast<float>(0x7f800000);
+    auto scale = if_then_else(1.0f/a < inf, 1.0f/a, 0.0f);
+    r *= scale;
+    g *= scale;
+    b *= scale;
+}
+HIGHP_STAGE(unpremul_polar, NoCtx) {
+    float inf = sk_bit_cast<float>(0x7f800000);
+    auto scale = if_then_else(1.0f/a < inf, 1.0f/a, 0.0f);
+    g *= scale;
+    b *= scale;
