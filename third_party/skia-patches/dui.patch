-LOWP_STAGE_PP(force_opaque    , NoCtx) {  a = U16_255; }
-LOWP_STAGE_PP(force_opaque_dst, NoCtx) { da = U16_255; }
-
-LOWP_STAGE_PP(swap_rb, NoCtx) {
-    auto tmp = r;
-    r = b;
-    b = tmp;
