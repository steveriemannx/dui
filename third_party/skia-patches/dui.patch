+static unsigned long
+get_hash_secret_salt(XML_Parser parser) {
+  const XML_Parser rootParser = getRootParserOf(parser, NULL);
+  assert(! rootParser->m_parentParser);
+
+  return rootParser->m_hash_secret_salt;
+}
