+    case DWRITE_COLOR_COMPOSITE_DEST_IN:
+        return SkBlendMode::kDstIn;
+    case DWRITE_COLOR_COMPOSITE_SRC_OUT:
+        return SkBlendMode::kSrcOut;
+    case DWRITE_COLOR_COMPOSITE_DEST_OUT:
