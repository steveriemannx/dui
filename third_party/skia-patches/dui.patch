-SI void highp_fixed_point(const SkRasterPipelineContexts::MemoryCtx* ctx,
-                          const size_t dx, const size_t dy,
-                          const F lane) {
-    auto ptr = ptr_at_xy<uint32_t>(ctx, dx,dy);
