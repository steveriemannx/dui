+        ImGui::SetNextWindowBgAlpha(0.5f);
+        if (ImGui::Begin("Color Histogram (R,G,B)", &fShowHistogramWindow)) {
+            const auto info = SkImageInfo::MakeN32Premul(fWindow->width(), fWindow->height());
+            SkAutoPixmapStorage pixmap;
+            pixmap.alloc(info);
