-        *r = ptr[0];
-        *g = ptr[1];
-        *b = ptr[2];
-        *a = ptr[3];
-    }
-    SI void store4(uint16_t* ptr, U16 r, U16 g, U16 b, U16 a) {
-        ptr[0] = r;
-        ptr[1] = g;
-        ptr[2] = b;
