-// clamp v to [0,limit).
-SI F clamp(F v, F limit) {
-    F inclusive = sk_bit_cast<F>(sk_bit_cast<U32>(limit) - 1);  // Exclusive -> inclusive.
-    return min(max(0.0f, v), inclusive);
-}
