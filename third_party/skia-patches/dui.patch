-        case Strategy::kRasterAtlas:
-            return "CPU Raster Atlas";
-        case Strategy::kTessellation:
-            return "Tessellation";
-        case Strategy::kTessellationAndSmallAtlas:
-            return "Tessellation w/ Small Path Atlas";
