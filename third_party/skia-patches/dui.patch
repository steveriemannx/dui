+    F h = r,
+      s = g,
+      l = b,
+      c = (1.0f - abs_(2.0f * l - 1)) * s;
+
+    auto hue_to_rgb = [&](F hue) {
+        F q = clamp_01_(abs_(fract(hue) * 6.0f - 3.0f) - 1.0f);
+        return (q - 0.5f) * c + l;
+    };
+
+    r = hue_to_rgb(h + 0.0f/3.0f);
+    g = hue_to_rgb(h + 2.0f/3.0f);
+    b = hue_to_rgb(h + 1.0f/3.0f);
