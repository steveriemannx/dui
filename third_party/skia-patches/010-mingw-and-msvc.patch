-// ~~~~~~ skgpu::Swizzle stage ~~~~~~ //
-
-HIGHP_STAGE(swizzle, void* ctx) {
-    auto ir = r, ig = g, ib = b, ia = a;
-    F* o[] = {&r, &g, &b, &a};
-    char swiz[4];
-    memcpy(swiz, &ctx, sizeof(swiz));
-
-    for (int i = 0; i < 4; ++i) {
-        switch (swiz[i]) {
-            case 'r': *o[i] = ir; break;
-            case 'g': *o[i] = ig; break;
-            case 'b': *o[i] = ib; break;
-            case 'a': *o[i] = ia; break;
-            case '0': *o[i] = F0; break;
-            case '1': *o[i] = F1; break;
-            default:              break;
-        }
-    }
-}
