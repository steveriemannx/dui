-LOWP_STAGE_GG(decal_y, SkRasterPipelineContexts::DecalTileCtx* ctx) {
-    auto h = ctx->limit_y;
-    sk_unaligned_store(ctx->mask, cond_to_mask_16((0 <= y) & (y < h)));
