+      _arch_flags = [
+        "-arch",
+        "arm64",
+        "-arch",
+        "arm64e",
+      ]
+    } else if (current_cpu == "x86") {
+      _arch_flags = [
+        "-arch",
+        "i386",
+      ]
+    } else if (current_cpu == "x64") {
+      _arch_flags = [
+        "-arch",
+        "x86_64",
+      ]
