-    ix = ix_and_ptr(&ptr, ctx, sx+1, sy);
-    U16 rightR, rightG, rightB, rightA;
-    from_8888(gather_unaligned<U32>(ptr, ix), &rightR,&rightG,&rightB,&rightA);
