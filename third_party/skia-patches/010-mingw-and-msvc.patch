-inline SkPoint SkVectorProjection(SkPoint a, SkPoint b) {
-    SkScalar length = b.length();
-    if (!length) {
-        return SkPoint();
-    }
-    SkPoint bNormalized = b;
-    bNormalized.normalize();
-    bNormalized.scale(SkPoint::DotProduct(a, b) / length);
-    return bNormalized;
-}
