-SI void load_88_(const uint16_t* ptr, U16* r, U16* g) {
-#if defined(SKRP_CPU_NEON)
-    uint8x8x2_t rg = vld2_u8((const uint8_t*)(ptr));
-    *r = cast<U16>(rg.val[0]);
-    *g = cast<U16>(rg.val[1]);
