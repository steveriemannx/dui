+      }
+    } else if (sanitize == "HWASAN") {
+      sanitizers = "hwaddress"
+    } else if (sanitize == "TSAN") {
+      sanitizers = "thread"
+    } else if (sanitize == "MSAN") {
+      sanitizers = "memory"
+    }
