-LOWP_STAGE_GP(evenly_spaced_gradient, const SkRasterPipelineContexts::GradientCtx* c) {
-    auto t = x;
-    auto idx = trunc_(t * static_cast<float>(c->stopCount-1));
-    gradient_lookup(c, idx, t, &r, &g, &b, &a);
-}
