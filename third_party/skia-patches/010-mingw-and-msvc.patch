-HIGHP_STAGE(evenly_spaced_gradient, const SkRasterPipelineContexts::GradientCtx* c) {
-    auto t = r;
-    auto idx = trunc_(t * static_cast<float>(c->stopCount-1));
-    gradient_lookup(c, idx, t, &r, &g, &b, &a);
-}
