-    Y = strip_sign(Y, &sign);
-    F Y_to_gamma_minus_one = apply_sign(approx_powf(Y, ctx[3]), sign);
-    r = r * Y_to_gamma_minus_one;
-    g = g * Y_to_gamma_minus_one;
-    b = b * Y_to_gamma_minus_one;
