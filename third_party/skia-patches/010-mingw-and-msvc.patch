+
+template <typename T> SK_API inline T sk_collection_check_bounds(T i, T size) {
+    if (0 <= i && i < size) SK_LIKELY {
+        return i;
+    }
+
+    SK_UNLIKELY {
+        #if defined(SK_DEBUG)
+            sk_print_index_out_of_bounds(static_cast<size_t>(i), static_cast<size_t>(size));
+        #else
+            SkUNREACHABLE;
+        #endif
+    }
