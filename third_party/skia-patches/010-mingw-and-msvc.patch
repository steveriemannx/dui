+          "$win_sdk/Lib/$win_sdk_version/ucrt/$current_cpu",
+          "$win_sdk/Lib/$win_sdk_version/um/$current_cpu",
+          "$win_vc/Tools/MSVC/$win_toolchain_version/lib/$current_cpu",
