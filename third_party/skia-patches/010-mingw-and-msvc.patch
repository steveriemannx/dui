-SI void from_1010102(U32 rgba, F* r, F* g, F* b, F* a) {
-    *r = cast((rgba      ) & 0x3ff) * (1/1023.0f);
-    *g = cast((rgba >> 10) & 0x3ff) * (1/1023.0f);
-    *b = cast((rgba >> 20) & 0x3ff) * (1/1023.0f);
-    *a = cast((rgba >> 30)        ) * (1/   3.0f);
