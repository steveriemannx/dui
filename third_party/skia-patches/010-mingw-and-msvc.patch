-    const uint32_t* ptr;
-    U32 ix = ix_and_ptr(&ptr, ctx, sx, sy);
-    U16 leftR, leftG, leftB, leftA;
-    from_8888(gather_unaligned<U32>(ptr, ix), &leftR,&leftG,&leftB,&leftA);
