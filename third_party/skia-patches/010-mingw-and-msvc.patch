-HIGHP_STAGE(hue, NoCtx) {
-    F R = r*a,
-      G = g*a,
-      B = b*a;
-
-    set_sat(&R, &G, &B, sat(dr,dg,db)*a);
-    set_lum(&R, &G, &B, lum(dr,dg,db)*a);
-    clip_color(&R,&G,&B, a*da);
-
-    r = mad(r, inv(da), mad(dr, inv(a), R));
-    g = mad(g, inv(da), mad(dg, inv(a), G));
-    b = mad(b, inv(da), mad(db, inv(a), B));
-    a = a + nmad(a, da, da);
-}
