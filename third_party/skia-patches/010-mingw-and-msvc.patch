-// clamp to (0,limit).
-SI F clamp_ex(F v, float limit) {
-    const F inclusiveZ = F_(std::numeric_limits<float>::min()),
-            inclusiveL = sk_bit_cast<F>( sk_bit_cast<U32>(F_(limit)) - 1 );
-    return min(max(inclusiveZ, v), inclusiveL);
