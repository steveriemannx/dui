-    F R = dr*a,
-      G = dg*a,
-      B = db*a;
-
-    set_sat(&R, &G, &B, sat( r, g, b)*da);
-    set_lum(&R, &G, &B, lum(dr,dg,db)* a);  // (This is not redundant.)
-    clip_color(&R,&G,&B, a*da);
-
-    r = mad(r, inv(da), mad(dr, inv(a), R));
-    g = mad(g, inv(da), mad(dg, inv(a), G));
-    b = mad(b, inv(da), mad(db, inv(a), B));
-    a = a + nmad(a, da, da);
