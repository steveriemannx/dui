-#if defined(SKRP_CPU_NEON)
-    uint8x8x2_t rg = {{
-        cast<U8>(r),
-        cast<U8>(g),
-    }};
-    vst2_u8((uint8_t*)(ptr), rg);
-#else
-    store(ptr, cast<U16>(r | (g<<8)) <<  0);
-#endif
-}
