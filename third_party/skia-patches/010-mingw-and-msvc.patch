+}
+HIGHP_STAGE(debug_g_255, const SkRasterPipelineContexts::MemoryCtx* ctx) {
+    auto ptr = ptr_at_xy<uint32_t>(ctx, dx,dy);
+
+    auto px = to_unorm(g, 255) << 8;
+    px |= 0xFF000000; // make opaque
