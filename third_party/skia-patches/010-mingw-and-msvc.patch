-// Binary operations take two adjacent inputs, and write their output in the first position.
-template <typename T, void (*ApplyFn)(T*, T*)>
-SI void apply_adjacent_binary(T* dst, T* src) {
-    T* end = src;
-    do {
-        ApplyFn(dst, src);
-        dst += 1;
-        src += 1;
-    } while (dst != end);
-}
