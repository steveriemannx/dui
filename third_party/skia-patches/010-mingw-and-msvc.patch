+          "$win_vc/Tools/MSVC/$win_toolchain_version/include",
+          "$win_sdk/Include/$win_sdk_version/shared",
+          "$win_sdk/Include/$win_sdk_version/ucrt",
+          "$win_sdk/Include/$win_sdk_version/um",
+          "$win_sdk/Include/$win_sdk_version/winrt",
