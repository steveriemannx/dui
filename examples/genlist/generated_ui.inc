    if(write(fd,buf,di)!=(ssize_t)di){close(fd);return _T("");}
    char tmp[32];snprintf(tmp,sizeof(tmp),"%d",fd);
    DString p=_T("/proc/self/fd/");
    for(char* x=tmp;*x;x++)p+=(DString::value_type)(unsigned char)*x;
    return p;
}

