<Window size="90%,80%" size_box="4,4,4,4" use_system_caption="false" snap_layout_menu="true" sys_menu="true" sys_menu_rect="0,0,36,36" caption="0,0,0,36" shadow_attached="true" layered_window="true" text="RichEdit Control Test Program">
    <!-- Class definitions under this window --> 
    <Font id="btn_font_bold_14" name="Elephant" size="14" bold="true"/>
    <Font id="btn_font_italic_14" name="Elephant" size="14" bold="true" italic="true"/>
    <Class name="checkbox_font_class" font="system_14" normal_text_color="black" disabled_text_color="gray" text_align="hcenter,vcenter" border_size="1" hot_border_color="#FFB3D0EE" pushed_border_color="#FF82B4E8" selected_normal_color="#FFC9E0F7" hot_color="#FFE8EFF7" selected_hot_color="#FFE8EFF7" pushed_color="#FFC9E0F7" selected_pushed_color="#FFC9E0F7"/>
    <Class name="btn_font_class" font="system_14" normal_text_color="black" disabled_text_color="gray" text_align="hcenter,vcenter" border_size="1" hot_border_color="#FFB3D0EE" pushed_border_color="#FF82B4E8" hot_color="#FFE8EFF7" pushed_color="#FFC9E0F7" />
    
    <!-- All controls in the entire window are placed in this VBox container -->  
    <VBox bkcolor="bk_wnd_darkcolor">
        <!-- Title bar area -->  
        <HBox name="window_caption_bar" width="stretch" height="36" bkcolor="bk_wnd_lightcolor">
            <!-- Title bar: display area at the top-left of the window -->  
            <HBox margin="0,0,30,0" valign="center" width="auto" height="auto" mouse_enabled="false">
                <Control width="18" height="18" bkimage="public/caption/logo.svg" valign="center" margin="8,0,0,0"/>
                <Label text="RichEdit Control Test Program" valign="center" margin="8,0,0,0" mouse_enabled="false"/>
            </HBox>
            <Control mouse_enabled="false"/>
            <!-- Title bar: window control area on the right; minimize, maximize, restore, and close buttons -->
            <HBox margin="0,0,0,0" valign="center" width="auto" height="36">
                <Button class="btn_wnd_min_11" height="32" width="40" name="minbtn" margin="0,2,0,2" tooltip_text="Minimize"/>
                <Box height="stretch" width="40" margin="0,2,0,2">
                    <Button class="btn_wnd_max_11" height="32" width="stretch" name="maxbtn" tooltip_text="Maximize"/>
                    <Button class="btn_wnd_restore_11" height="32" width="stretch" name="restorebtn" visible="false" tooltip_text="Restore"/>
                </Box>
                <Button class="btn_wnd_close_11" height="stretch" width="40" name="closebtn" margin="0,0,0,2" tooltip_text="Close"/>
            </HBox>
        </HBox> <!-- End of title bar area --> 
        
        <!-- Display area --> 
        <HBox>
            <!-- Left area -->
            <VScrollBox width="360" vscrollbar="true" minwidth="60" bkcolor="SeaShell" border_size="1,1,0,1" border_color="blue">
                <GroupVBox margin="6,6,6,6" text="Password Functions" height="auto" corner_size="4,4">
                    <HBox height="36" margin="8,16,8,0">
                        <Label text="Password Input:  " valign="center"/>
                        <RichEdit class="simple" text="This is password!" password="true" valign="center" text_align="vcenter" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="36" margin="8,0,8,0">
                        <Label text="Show Password:  " valign="center"/>
                        <RichEdit class="simple" text="This is password!" password="true" show_password="true" valign="center" text_align="vcenter" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="36" margin="8,0,8,0">
                        <Label text="Flash Password Chars:  " valign="center"/>
                        <RichEdit class="simple" text="This is password!" password="true" flash_password_char="true" show_password="false" valign="center" text_align="vcenter" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="36" margin="8,0,8,8">
                        <Label text="Password char is #:  " valign="center"/>
                        <RichEdit class="simple" text="This is password!" password="true" password_char="#" valign="center" text_align="vcenter" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                </GroupVBox>
                <GroupVBox margin="6,6,6,6" text="Basic Functions" height="auto" corner_size="4,4">
                    <HBox height="36" margin="8,16,8,0">
                        <Label text="Single Line Edit:  " valign="center"/>
                        <RichEdit class="simple simple_border" text="RichEdit: simple" default_context_menu="true" valign="center" text_align="vcenter" text_padding="2,0,0,0" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="44" margin="8,0,8,0">
                        <Label text="Single Line Edit:  " valign="center"/>
                        <RichEdit class="simple simple_border" text="RichEdit: edit" valign="center" text_align="vcenter" text_padding="4,4,4,4" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="36" margin="8,0,8,0">
                        <Label text="Hint Mode:  " valign="center"/>
                        <RichEdit class="prompt simple simple_border_bottom" prompttext="You can type text here" valign="center" text_align="vcenter" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="36" margin="8,0,8,0">
                        <Label text="Number Mode:  " valign="center"/>
                        <RichEdit class="simple" text="0123456789" number="true" valign="center" text_align="vcenter" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="36" margin="8,0,8,0">
                        <Label text="Read Only:  " valign="center"/>
                        <RichEdit class="simple" text="RichEdit: readonly" readonly="true" no_caret_readonly="true" valign="center" text_align="vcenter" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="36" margin="8,0,8,0">
                        <Label text="Disabled Mode:  " valign="center"/>
                        <RichEdit class="simple" enabled="false" text="RichEdit: disabled" valign="center" text_align="vcenter" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="36" margin="8,0,8,0">
                        <Label text="HyperLink:  " valign="center"/>
                        <RichEdit name="test_url" auto_detect_url="true" text="Visit URL: http://www.baidu.com" readonly="true" no_caret_readonly="true" valign="center" text_align="vcenter" text_padding="2,0,0,0" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="36" margin="8,0,8,0">
                        <Label text="Text Color:  " valign="center"/>
                        <RichEdit class="simple" text="RichEdit: text color is red" normal_text_color="red" valign="center" text_align="vcenter" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="36" margin="8,0,8,0">
                        <Label text="Cursor Color:  " valign="center"/>
                        <RichEdit class="simple" text="RichEdit: cursor color is red" caret_color="red" valign="center" text_align="vcenter" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="48" margin="8,0,8,0">
                        <Label text="Text Align:  " valign="center"/>
                        <RichEdit class="simple" text="text_align={left/hcenter/right,top/vcenter/bottom}" text_align="hcenter,vcenter" valign="center" text_align="vcenter" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="36" margin="8,0,8,8">
                        <Label text="Max 8 characters:  " valign="center"/>
                        <RichEdit class="simple" text="Max 8 characters" max_char="8" valign="center" text_align="vcenter" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                </GroupVBox>
                
                <GroupVBox margin="6,6,6,6" text="Common Functions" height="auto" corner_size="4,4">
                    <HBox height="36" margin="8,16,8,0">
                        <Label text="Spin:  " valign="center"/>
                        <RichEdit class="simple simple_border rich_edit_spin" min_number="-64" max_number="64" limit_text="3" margin="4,6,4,4"/>
                        <Label text="(Number range: -64 - 64)" valign="center"/>
                    </HBox>
                    <HBox height="36" margin="8,0,8,0">
                        <Label text="Clear Text:  " valign="center"/>
                        <RichEdit class="simple simple_border rich_edit_clear_btn" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="36" margin="8,0,8,8">
                        <Label text="Show Password:  " valign="center"/>
                        <RichEdit class="simple simple_border rich_edit_show_password_btn" margin="4,6,4,4"/>
                    </HBox>
                </GroupVBox>
                
                <GroupVBox margin="6,6,6,6" text="Scrollbar Related" height="auto" corner_size="4,4">
                    <HBox height="48" margin="8,16,8,0">
                        <Label text="Horizontal Scrollbar:  " valign="center"/>
                        <RichEdit text="Horizontal test 0 test 1 test 2 test 3 test 4 test 5 test 6 test 7 test 8" multi_line="true" word_wrap="false" hscrollbar="true" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="48" margin="8,0,8,0">
                        <Label text="Vertical Scrollbar:  " valign="center"/>
                        <RichEdit text="Vertical test 0 test 1 test 2 test 3 test 4 test 5 test 6 test 7 test 8 test 9 test 10 test 11 test 12 test 13 test 14" multi_line="true" want_return="true" word_wrap="true" vscrollbar="true" bkcolor="white" margin="4,6,4,4"/>
                    </HBox>
                    <HBox height="48" margin="8,0,8,8">
                        <Label text="Both Horizontal and Vertical Scrollbars:  " valign="center"/>
                        <RichEdit text="Vertical test 0 test 1 test 2 test 3 test 4 test 5 test 6 test 7 test 8 test 9 test 10 test 11 test 12 test 13 test 14" multi_line="true" want_return="true" word_wrap="false" vscrollbar="true" hscrollbar="true" bkcolor="white" margin="4,6,4,4"/>
                    </HBox> 
                </GroupVBox>
                
            </VScrollBox>
            <!-- Vertical splitter bar, used to adjust the sizes of the left and right areas -->
            <Split bkcolor="splitline_level1" width="2"/>
            <!-- Right area -->
            <VBox>
                <VBox bkcolor="bk_wnd_darkcolor" height="auto" minheight="40" >
                    <HBox height="auto" margin="0,2,2,0">
                        <Label text="File:" valign="center" margin="8,0,8,0"/>
                        <Button class="btn_global_gray_80x30" name="open_file" width="100" height="28" text="Open (Ctrl+O)" borderround="2,2" valign="center" margin="4,0,4,0"/>
                        <Button class="btn_global_gray_80x30" name="save_file" width="100" height="28" text="Save (Ctrl+S)" borderround="2,2" valign="center" margin="4,0,4,0"/>
                        <Button class="btn_global_gray_80x30" name="save_as_file" width="160" height="28" text="Save As (Ctrl+Shift+S)" borderround="2,2" valign="center" margin="4,0,4,0"/>
                    </HBox>
                    <HBox height="auto" margin="0,2,2,0">
                        <Label text="Edit:" valign="center" margin="8,0,8,0"/>
                        <Button class="btn_global_gray_80x30" name="btn_copy" width="100" height="28" text="Copy (Ctrl+C)" borderround="2,2" valign="center" margin="4,0,4,0"/>
                        <Button class="btn_global_gray_80x30" name="btn_cut" width="100" height="28" text="Cut (Ctrl+X)" borderround="2,2" valign="center" margin="4,0,4,0"/>
                        <Button class="btn_global_gray_80x30" name="btn_paste" width="100" height="28" text="Paste (Ctrl+V)" borderround="2,2" valign="center" margin="4,0,4,0"/>
                        <Button class="btn_global_gray_80x30" name="btn_delete" width="100" height="28" text="Delete (Del)" borderround="2,2" valign="center" margin="4,0,4,0"/>
                        <Button class="btn_global_gray_80x30" name="btn_sel_all" width="100" height="28" text="Select All (Ctrl+A)" borderround="2,2" valign="center" margin="4,0,8,0"/>
                        <Button class="btn_global_gray_80x30" name="btn_sel_none" width="100" height="28" text="Deselect" borderround="2,2" valign="center" margin="4,0,8,0"/>
                        <Button class="btn_global_gray_80x30" name="btn_undo" width="100" height="28" text="Undo (Ctrl+Z)" borderround="2,2" valign="center" margin="4,0,4,0"/>
                        <Button class="btn_global_gray_80x30" name="btn_redo" width="100" height="28" text="Redo (Ctrl+Y)" borderround="2,2" valign="center" margin="4,0,4,0"/>
                    </HBox>
                    <HBox height="auto" margin="0,2,2,0">
                        <Label text="Find:" valign="center" margin="8,0,8,0"/>
                        <Button class="btn_global_gray_80x30" name="btn_find_text" width="100" height="28" text="Find (Ctrl+F)" borderround="2,2" valign="center" margin="4,0,4,0"/>
                        <Button class="btn_global_gray_80x30" name="btn_find_next" width="100" height="28" text="Find Next (F3)" borderround="2,2" valign="center" margin="4,0,4,0"/>
                        <Button class="btn_global_gray_80x30" name="btn_replace_text" width="100" height="28" text="Replace (Ctrl+H)" borderround="2,2" valign="center" margin="4,0,4,0"/>
                   </HBox>
                   <HBox height="auto" margin="0,2,2,0">
                        <Label text="Font:" valign="center" margin="8,0,8,0"/>
                        <Button class="btn_global_gray_80x30" name="set_font" width="100" height="28" text="Set Font" borderround="2,2" valign="center" margin="4,0,4,2"/>
                        <Combo class="combo" name="combo_font_name" combo_icon_class="" combo_type="drop_down" dropbox_size="0,300" height="28" width="160" tooltiptext="Select Font" margin="2,0,2,2"/>
                        <Combo class="combo" name="combo_font_size" combo_icon_class="" combo_type="drop_down" dropbox_size="0,300" height="28" width="60" margin="2,0,2,0" tooltiptext="Select Font"/>
                        <CheckBox class="checkbox_font_class" name="btn_font_bold" width="28" height="26" text="B" font="btn_font_bold_14" valign="center" margin="2,1,1,3" tooltiptext="Bold: change to heavier font"/>
                        <CheckBox class="checkbox_font_class" name="btn_font_italic" width="28" height="26" text="I" font="btn_font_italic_14" valign="center" margin="1,1,1,3" tooltiptext="Italic: change to slanted font"/>
                        <CheckBox class="checkbox_font_class" name="btn_font_underline" width="28" height="26" text="U" font="system_underline_14" valign="center" margin="1,1,1,3" tooltiptext="Underline: draw a line under the text"/>
                        <CheckBox class="checkbox_font_class" name="btn_font_strikeout" width="28" height="26" text="abc" font="system_strikeout_14" valign="center" margin="1,1,1,3" tooltiptext="Strikethrough: draw a line through the text"/>
                        <Button class="btn_font_class" name="btn_font_size_increase" width="32" height="26" text="A+" font="btn_font_bold_14" valign="center" margin="1,1,1,3" tooltiptext="Increase Font Size"/>
                        <Button class="btn_font_class" name="btn_font_size_decrease" width="32" height="26" text="A-" font="btn_font_bold_14" valign="center" margin="1,1,1,3" tooltiptext="Decrease Font Size"/>
                        <ComboButton class="combo_button" name="color_combo_button" height="28" width="48" dropbox_size="240,300" left_button_top_label_text="A" left_button_bottom_label_bkcolor="skyblue"/>
                        <Label text="(rich text mode sets the format of the currently selected text)" font="system_12" valign="center" margin="2,0,2,0" tooltiptext="Rich text mode sets the format of the currently selected text; plain text mode sets the format of all text."/>
                   </HBox>
                   <HBox height="auto" margin="0,2,2,0">
                        <Label text="Zoom:" valign="center" margin="8,0,8,0"/>
                        <Label text="Current Zoom:" valign="center"/>
                        <Label name="lavel_zoom_value" text="100.0%" font="system_bold_14" valign="center" margin="0,0,12,0"/>
                        <Button class="btn_font_class" name="btn_zoom_in" width="64" height="26" text="Zoom In +" font="system_14" valign="center" margin="1,1,1,3" tooltiptext="Increase Font Size"/>
                        <Button class="btn_font_class" name="btn_zoom_out" width="64" height="26" text="Zoom Out -" font="system_14" valign="center" margin="1,1,1,3" tooltiptext="Decrease Font Size"/>
                        <Button class="btn_font_class" name="btn_zoom_off" width="120" height="26" text="Reset to 100%" font="system_14" valign="center" margin="1,1,1,3" tooltiptext="Reset Font Size to 100%"/>
 
                   </HBox>
                   <HBox height="auto" margin="0,2,2,2">
                        <Label text="Others:" valign="center" margin="8,0,8,0"/>
                        <CheckBox class="checkbox_1" name="btn_word_wrap" text="Auto Wrap" margin="4,0,0,0" selected="true" tooltiptext="Auto Wrap"/>
                        <CheckBox class="checkbox_1" name="btn_rich_text" text="Rich Text Mode" margin="12,0,0,0" selected="true" tooltiptext="Support Rich Text Format"/>
                        <Label text="Line Spacing:" valign="center" margin="12,0,0,0"/>
                        <Option class="option_1" group="richedit_row_spacing_group" text="1.0" margin="6,0,0,0" text_align="vcenter" selected="true">
                            <Event type="select" receiver="rich_edit" apply_attribute="row_spacing_mul='1.0'" />
                        </Option>
                        <Option class="option_1" group="richedit_row_spacing_group" text="1.15" margin="6,0,0,0" text_align="vcenter">
                            <Event type="select" receiver="rich_edit" apply_attribute="row_spacing_mul='1.15'" />
                        </Option>
                        <Option class="option_1" group="richedit_row_spacing_group" text="1.5" margin="6,0,0,0" text_align="vcenter">
                            <Event type="select" receiver="rich_edit" apply_attribute="row_spacing_mul='1.5'" />
                        </Option>
                        <Option class="option_1" group="richedit_row_spacing_group" text="2.0" margin="6,0,0,0" text_align="vcenter">
                            <Event type="select" receiver="rich_edit" apply_attribute="row_spacing_mul='2.0'" />
                        </Option>
                        <Option class="option_1" group="richedit_row_spacing_group" text="2.5" margin="6,0,0,0" text_align="vcenter">
                            <Event type="select" receiver="rich_edit" apply_attribute="row_spacing_mul='2.5'" />
                        </Option>
                        <Option class="option_1" group="richedit_row_spacing_group" text="3.0" margin="6,0,0,0" text_align="vcenter">
                            <Event type="select" receiver="rich_edit" apply_attribute="row_spacing_mul='3.0'" />
                        </Option>
                        <Label name="row_spacing_tips" text="(Line spacing: only effective in rich text mode)" valign="center" margin="4,0,0,0"/>
                   </HBox>
                </VBox>
                <!-- Horizontal splitter bar, used to adjust the sizes of the upper and lower areas -->
                <Split bkcolor="splitline_level1" height="2"/>
                <HBox bkcolor="Pink" border_size="1" border_color="blue" minwidth="60">
                    <RichEdit name="rich_edit" enable_drag_drop="true" zoom="0,0" wheel_zoom="true" multi_line="true" want_return="true" word_wrap="true" rich_text="false" default_context_menu="true" save_selection="true" hide_selection="false" word_wrap="true" vscrollbar="true" auto_vscroll="true" bkcolor="white"/>
                </HBox>
            </VBox>
        </HBox>
    </VBox>
</Window>
