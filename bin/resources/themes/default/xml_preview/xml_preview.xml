<?xml version="1.0" encoding="UTF-8"?>
<Window size="75%,85%" min_size="300,200" 
        caption="0,0,0,36" use_system_caption="false" snap_layout_menu="true" sys_menu="true" sys_menu_rect="0,0,36,36" 
        shadow_type="default" shadow_attached="true" shadow_snap="true" layered_window="true" 
        alpha="255" size_box="4,4,4,4" icon="public/caption/logo.ico">
    <VBox bkcolor="bk_wnd_darkcolor" visible="true">    
        <!-- Title bar area -->  
        <HBox name="window_caption_bar" width="stretch" height="36" bkcolor="bk_wnd_lightcolor">
            <!-- Title bar: display area at the top-left of the window -->  
            <HBox margin="0,0,30,0" valign="center" width="auto" height="auto" mouse_enabled="false">
                <Label text="XML File UI Preview Test" valign="center" margin="8,0,0,0" mouse_enabled="false"/>
            </HBox>
            <Control mouse_enabled="false"/>            
            <!-- Title bar: window control area on the right; minimize, maximize, restore, and close buttons -->
            <HBox margin="0,0,0,0" valign="center" width="auto" height="36">
                <Button class="btn_wnd_min_11" height="32" width="40" name="minbtn" margin="0,2,0,2" tooltip_text="Minimize"/>
                <Box height="stretch" width="40" margin="0,2,0,2">
                    <Button class="btn_wnd_max_11" height="32" width="stretch" name="maxbtn" tooltip_text="Maximize"/>
                    <Button class="btn_wnd_restore_11" height="32" width="stretch" name="restorebtn" visible="false" tooltip_text="Restore"/>
                </Box>
                <Button class="btn_wnd_close_11" height="stretch" width="40" name="closebtn" margin="0,0,0,2" tooltip_text="Close"/>
            </HBox>
        </HBox> <!-- End of title bar area --> 
        
        <!-- Work area: everything outside the title bar goes into this large Box area -->
        <VBox padding="10,10,10,10">
            <VBox height="auto">
                <HBox height="auto">
                    <Label text="XML File Path:" valign="center"/>
                    <Label name="xml_file_path" text="" valign="center" width="100%" path_ellipsis="true" single_line="true" auto_tooltip="true"/>                    
                </HBox>
                <HBox height="auto">
                    <Label text="XML Load Result:" valign="center"/>
                    <Label name="xml_file_load_result" text="" valign="center" width="100%" />
                </HBox>
                <HBox height="auto">
                    <Label name="xml_file_path" text="You can drag an XML file into the display area below to preview it" text_align="vcenter" valign="center" height="30"/>
                    <Control />
                    <CheckBox class="checkbox_2" name="checkbox_auto_refresh" text="Auto Refresh" margin="0,0,8,0" selected="false"/>
                    <Label text="Interval (seconds):" text_align="vcenter" valign="center"/>
                    <RichEdit class="simple simple_border rich_edit_spin" name="auto_refresh_interval" min_number="1" max_number="60" limit_text="2" text="5" height="30" margin="0,0,8,0"/>
                    <Button class="btn_global_color_gray" name="btn_clear_xml_file" text="Clear Preview" width="120" height="30" border_round="3,3" margin="0,0,8,0"/>
                    <Button class="btn_global_color_gray" name="btn_browse_xml_file" text="Open XML File..." width="120" height="30" border_round="3,3" margin="0,0,10,0"/>
                </HBox>
            </VBox>
            <XmlBox name="xml_box_test" bkcolor="white" border_color="blue" border_size="1" border_dash_style="dash" margin="4,4,4,4"
                    mouse_child="true"
                    res_path="controls" 
                    xml_file_path="controls.xml"/>
        </VBox>
    </VBox>
</Window>